# Cloud Text Expander — Backend Environment Variables

# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────
# Paste your Supabase Project URL and API Key (anon/public)
SUPABASE_URL="your-supabase-url-here"
SUPABASE_KEY="your-supabase-anon-key-here"

# ── CORS ─────────────────────────────────────────────
# In production, set this to your extension origin or admin dashboard domain
CORS_ORIGIN="*"
